<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="8dp">

    <!-- Encrypted Moment Image Display -->
    <ImageView
        android:id="@+id/widget_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Encrypted Live Note" />

    <!-- Top Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/widget_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ TwinWidget"
            android:textColor="#F9F9F9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#99010101"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live"
            android:textColor="#EDE8E4"
            android:textSize="10sp"
            android:background="#99010101"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

</RelativeLayout>
